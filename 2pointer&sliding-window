---------------------------------------------------- Container With Most Water -------------------------------------------------------------------------------------------
/*

https://leetcode.com/problems/container-with-most-water/description/

Complexity Analysis

Time complexity: O(n). Single pass.

Space complexity: O(1). Constant space is used.

Idea : for area as we have to find the length and width.
Width :  we have to find the difference b/w two positions the max difference would be the first nd last index.
Length : We keep checking for the maximum length in between to keep maximizing the area and keep updating the results.

*/

class Solution {
public:
    int maxArea(vector<int>& height) {
        int maxArea = 0;
        int left = 0;
        int right = height.size() - 1;

        while (left < right) {
            int width = right - left;
            maxArea = max(maxArea, min(height[left], height[right]) * width);
            if (height[left] <= height[right]) {
                left++;
            } else {
                right--;
            }
        }
        return maxArea;
    }
};

----------------------------------------------------------------------- Valid Palindrome --------------------------------------------------------------------------------------

/*
https://neetcode.io/problems/is-palindrome/solution
*/

class Solution {
public:


bool alphanum(char c)
{
  return (c >= 'A' && c <= 'Z' ||
                c >= 'a' && c <= 'z' ||
                c >= '0' && c <= '9');
      
}
    bool isPalindrome(string s) 
    {

      int l = 0;
      int r = s.length()-1;

      while(l<r)
      {
        //skip for all the character if do not belong to alphanum.
        while(l<r and !alphanum(s[l]))
        l++;

       //same for the backward direction
        while(r>l and !alphanum(s[r]))
        r--;

        //check if the character is equal or not
        if(tolower(s[l])!=tolower(s[r]))
        return false;

        l++;
        r--;
      }

      return true;
        
    }
};

------------------------------------------------------- Two integers Sum || -----------------------------------------------------------------------------------------------
https://neetcode.io/problems/two-integer-sum-ii/question

class Solution {
public:
    vector<int> twoSum(vector<int>& numbers, int target) 
    {

        int n = numbers.size();
        
        int start = 0;
        int end = n-1;

        while(start<end)
        {
            if(numbers[start] + numbers[end] == target)
            return{start+1, end+1};

            else if (numbers[start]+numbers[end] < target)
            start++;

            else
            end--;
        }

        return {};
        
    }
};


--------------------------------------------------------------- 3 sum ---------------------------------------------------------------------------------------------------
https://neetcode.io/problems/three-integer-sum/question

class Solution {
public:
    vector<vector<int>> threeSum(vector<int>& nums) 
    {
      int n = nums.size();
      sort(nums.begin(), nums.end());

      vector<vector<int>>ans;

      for(int i = 0 ; i<n ; i++)
      {
        //if the first element is positive only, then there will be no triplet sum.

        if(nums[i] > 0)
        break;

        //now we can skip the duplicates.
        if(i>0 and nums[i] == nums[i-1])
        continue;

        int start = i+1;
        int end = n-1;

        while(start<end)
        {
            int sum = nums[i]+nums[start]+nums[end];
            
            if(sum > 0)
            end--;

            else if(sum<0)
            start++;

            else
            {
              ans.push_back({nums[i], nums[start], nums[end]});
              start++;
              end--;

              while(start<end and nums[start]==nums[start-1])
              start++;
            }

        }
      }

        return ans;
    }
};


------------------------------------------------------------- Trapping Rain water ---------------------------------------------------------------------------------------------------------------
https://neetcode.io/problems/trapping-rain-water/question

1. Prefix and suffix arrays :

Time complexity : 0(n)
Space Complexity:O(n)

class Solution {
public:
    int trap(vector<int>& height) 
    {
       int n = height.size();

       if(n == 0)
       return 0;

       vector<int>leftmax(n);
       vector<int>rightmax(n);

       leftmax[0] = height[0];
       for(int i =1 ; i<n ; i++)
       {
        leftmax[i]=max(leftmax[i-1], height[i]);
       }

       rightmax[n-1] =height[n-1];
       for(int i = n-2 ; i>=0 ; i--)
       {
        rightmax[i]=max(rightmax[i+1],height[i]);
       }

       int res = 0;
       for(int i = 0;i<n ; i++)
       {
        res+=min(leftmax[i],rightmax[i])-height[i];
       }
       
       return res;
        
    }
};

2. Two pointers

T.C : O(n)
S.C : O(1)

class Solution {
public:
    int trap(vector<int>& height) 
    {

        int n = height.size();
        if(n == 0)
        return 0;

        int l = 0;
        int r = n-1;

        int leftmax=height[l];
        int rightmax=height[r];

        int res = 0;

        while(l<r)
        {
          if(leftmax<rightmax)
          {
            l++;
            leftmax = max(leftmax, height[l]);
            res+= leftmax-height[l];
          }
        else
        {
            r--;
            rightmax = max(rightmax, height[r]);

            res+= rightmax-height[r];
        }
        
        
        }

        return res;
    }
};

